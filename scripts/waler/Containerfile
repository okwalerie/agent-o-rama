# Build environment for scripts/build-release.sh on waler: JDK 21 + lein,
# Node (shadow-cljs / npm ci), zip/unzip. Built and cached by deploy.sh.
FROM docker.io/library/node:22-bookworm-slim AS node

FROM docker.io/library/clojure:temurin-21-lein
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && apt-get update \
 && apt-get install -y --no-install-recommends zip unzip \
 && rm -rf /var/lib/apt/lists/*
